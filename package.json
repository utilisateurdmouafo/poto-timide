{
    "name": "poto-timide",
    "version": "1.0.0",
    "description": "Poto Timide - gestion du groupe avec auth et Turso/SQLite",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js",
        "test": "node --test",
        "dev:react": "vite --config frontend/vite.config.mjs",
