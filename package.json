        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "socket.io": "^4.8.4",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.2",
        "tailwindcss": "^4.3.3",
        "vite": "^8.3.2"
